# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요
# cp .env.example .env

# ─── 공통: 로컬 Ollama ───
# 미리 받아 둘 모델: ollama pull bge-m3 / ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# ─── 문서 모드 (RAG) ───
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b
# 답변 생성 타임아웃(초). CPU에서는 수십 초가 걸린다
OLLAMA_TIMEOUT=180
# 1차 미답변 판정 유사도 기준 (bge-m3 기준값. 임베딩 모델을 바꾸면 다시 맞춘다)
RAG_SIMILARITY_THRESHOLD=0.55
# 답변 근거로 쓸 문서 조각 수
TOP_K=3

# ─── SQL 모드 (text-to-sql) ───
TTS_OLLAMA_URL=http://localhost:11434
TTS_OLLAMA_MODEL=qwen2.5:7b
# 사이트 프로필 이름 (text-to-sql 패키지의 metadata/sites/<이름>.json)
TTS_SITE=demo

# ─── 로그인 · DB ───
# JWT 서명 키. 충분히 긴 임의의 문자열
JWT_SECRET=여기에_임의의_긴_문자열
# PostgreSQL 접속 주소 (사용자·질문 이력 저장)
DATABASE_URL=postgresql://아이디:비밀번호@호스트:5432/postgres
